#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🚀 Running pre-push hooks...${NC}"

# Function to validate branch naming convention
validate_branch_name() {
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    VALID_PATTERN="^(feat|feature|fix|bugfix|hotfix|docs|test|chore|patch|refactor)\/[a-z0-9-]+$"

    echo -e "${YELLOW}🌳 Validating branch name: $BRANCH${NC}"

    # Allow pushing to protected branches
    if [[ "$BRANCH" == "main" || "$BRANCH" == "master" || "$BRANCH" == "develop" ]]; then
        echo -e "${GREEN}✅ Pushing to protected branch: $BRANCH${NC}"
        return 0
    fi

    # Validate feature branch naming
    if [[ ! $BRANCH =~ $VALID_PATTERN ]]; then
        echo -e "${RED}❌ Branch name '$BRANCH' does not follow naming convention.${NC}"
        echo ""
        echo "Expected pattern: type/description"
        echo "Examples:"
        echo "  feat/user-authentication (Conventional Commits style)"
        echo "  feature/user-authentication (Git Flow style)"
        echo "  fix/login-issue (Conventional Commits style)"
        echo "  bugfix/login-issue (Git Flow style)"
        echo "  docs/api-documentation"
        echo "  test/integration-tests"
        echo "  chore/dependency-updates"
        echo ""
        exit 1
    fi
    
    echo -e "${GREEN}✅ Branch name follows convention: $BRANCH${NC}"
}

# STEP 1: Validate branch naming
validate_branch_name

# STEP 2: Clean build and run all tests
echo -e "${YELLOW}🧪 Step 2: Running clean build and tests...${NC}"
if ./gradlew clean test --no-daemon --console=plain --quiet > /dev/null 2>&1; then
    echo -e "${GREEN}✅ All tests passed${NC}"
else
    echo -e "${RED}❌ Tests failed. Please fix all failing tests before pushing.${NC}"
    echo -e "${YELLOW}💡 Run './gradlew clean test' to see detailed error messages${NC}"
    exit 1
fi

# STEP 3: Build the entire project
echo -e "${YELLOW}🔨 Step 3: Building project...${NC}"
if ./gradlew build --no-daemon --console=plain --quiet > /dev/null 2>&1; then
    echo -e "${GREEN}✅ Build successful${NC}"
else
    echo -e "${RED}❌ Build failed. Please fix build issues before pushing.${NC}"
    echo -e "${YELLOW}💡 Run './gradlew build' to see detailed error messages${NC}"
    exit 1
fi

# STEP 4: Run static analysis (checkstyle + any other quality checks)
echo -e "${YELLOW}🔍 Step 4: Running static analysis...${NC}"
if ./gradlew check --no-daemon --console=plain --quiet > /dev/null 2>&1; then
    echo -e "${GREEN}✅ Static analysis passed${NC}"
else
    echo -e "${RED}❌ Static analysis checks failed. Please fix quality issues before pushing.${NC}"
    echo -e "${YELLOW}💡 Run './gradlew check' to see detailed error messages${NC}"
    exit 1
fi

# STEP 5: Check for any uncommitted changes (optional warning)
if ! git diff --quiet || ! git diff --cached --quiet; then
    echo -e "${YELLOW}⚠️  Warning: You have uncommitted changes. Consider committing them before pushing.${NC}"
    echo -e "${YELLOW}ℹ️  This is a warning only - push will proceed.${NC}"
fi

echo -e "${GREEN}🎉 All pre-push hooks completed successfully! Ready to push.${NC}"
exit 0 