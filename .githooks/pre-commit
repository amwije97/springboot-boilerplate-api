#!/bin/bash
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🚀 Running pre-commit hooks...${NC}"

# Function to check if we're in a git repository
check_git_repo() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo -e "${RED}❌ Not in a git repository${NC}"
        exit 1
    fi
}

# Function to check for staged files
has_staged_files() {
    git diff --cached --name-only | grep -q "\.java$"
}

# STEP 1: Check for staged Java files (informational)
echo -e "${YELLOW}📝 Step 1: Checking staged files...${NC}"

# Get staged Java files
STAGED_JAVA_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(java)$' || true)

if [ -n "$STAGED_JAVA_FILES" ]; then
    echo -e "${BLUE}  Found staged Java files:${NC}"
    echo "$STAGED_JAVA_FILES" | sed 's/^/    /'
    echo -e "${YELLOW}  💡 Tip: Make sure your IDE is configured for auto-formatting on save${NC}"
else
    echo -e "${YELLOW}ℹ️  No staged Java files found${NC}"
fi

# STEP 2: Run Checkstyle
echo -e "${YELLOW}🔍 Step 2: Running Checkstyle...${NC}"
if ./gradlew checkstyleMain checkstyleTest --console=plain --quiet > /dev/null 2>&1; then
    echo -e "${GREEN}✅ Checkstyle passed${NC}"
else
    echo -e "${RED}❌ Checkstyle violations found. Please fix the code quality issues.${NC}"
    echo -e "${YELLOW}💡 Run './gradlew checkstyleMain checkstyleTest' to see detailed violations${NC}"
    exit 1
fi

# STEP 3: Check for TODO/FIXME comments in staged files
echo -e "${YELLOW}📝 Step 3: Checking for TODO/FIXME comments...${NC}"
check_git_repo

# Get staged Java files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(java)$' || true)

if [ -n "$STAGED_FILES" ]; then
    # Check for TODO/FIXME in staged changes
    TODOS=$(git diff --cached $STAGED_FILES | grep -iE '^\+.*\b(TODO|FIXME|XXX|HACK)\b' || true)
    if [ -n "$TODOS" ]; then
        echo -e "${YELLOW}⚠️  Found TODO/FIXME comments in staged files:${NC}"
        echo "$TODOS"
        echo ""
        echo "Consider resolving these before committing, or add // NOSONAR if intentional."
        echo -e "${YELLOW}ℹ️  This is a warning only - commit will proceed.${NC}"
    else
        echo -e "${GREEN}✅ No TODO/FIXME comments found in staged files${NC}"
    fi
else
    echo -e "${YELLOW}ℹ️  No Java files staged for commit${NC}"
fi

# STEP 4: Run tests
echo -e "${YELLOW}🧪 Step 4: Running tests...${NC}"
if ./gradlew test --console=plain --quiet --no-daemon > /dev/null 2>&1; then
    echo -e "${GREEN}✅ All tests passed${NC}"
else
    echo -e "${RED}❌ Tests failed. Please fix failing tests before committing.${NC}"
    echo -e "${YELLOW}💡 Run './gradlew test' to see detailed test failures${NC}"
    exit 1
fi

echo -e "${GREEN}🎉 All pre-commit hooks completed successfully!${NC}"
exit 0 