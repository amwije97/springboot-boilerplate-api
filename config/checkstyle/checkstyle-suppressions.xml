<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress FinalLocalVariable for test classes - allows mutable test variables -->
    <suppress checks="FinalLocalVariable" files=".*Test\.java"/>
    <suppress checks="FinalLocalVariable" files=".*Tests\.java"/>
    <suppress checks="FinalLocalVariable" files=".*IT\.java"/>
    
    <!-- Allow higher complexity for Spring configuration classes -->
    <suppress checks="CyclomaticComplexity" files=".*Config\.java"/>
    <suppress checks="CyclomaticComplexity" files=".*Configuration\.java"/>
    
    <!-- Suppress specific checks for generated files -->
    <suppress checks=".*" files=".*[\\/]generated[\\/].*\.java"/>
    <suppress checks=".*" files=".*[\\/]target[\\/].*\.java"/>
    <suppress checks=".*" files=".*[\\/]build[\\/].*\.java"/>

    <!-- Allow descriptive test method names with underscores -->
    <suppress checks="MethodName" files=".*Test\.java"/>
    <suppress checks="MethodName" files=".*Tests\.java"/>
    <suppress checks="MethodName" files=".*IT\.java"/>
    
</suppressions> 